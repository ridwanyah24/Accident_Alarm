// Prisma schema for Road Accident Response System
// Primary database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REPORTER
  RESPONDER
  DISPATCHER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum AgencyType {
  AMBULANCE
  POLICE
  FIRE
  ROAD_SAFETY
  DISASTER_MANAGEMENT
  OTHER
}

enum IncidentCategory {
  COLLISION
  VEHICLE_ROLLOVER
  PEDESTRIAN_STRUCK
  MOTORCYCLE_INCIDENT
  VEHICLE_FIRE
  OBSTRUCTION_OR_OTHER
}

enum ReporterSeverity {
  MINOR
  SERIOUS
  CRITICAL
  UNSURE
}

enum OperationalPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LocationSource {
  GPS
  MAP_PIN
  MANUAL
}

enum VerificationState {
  PENDING
  VERIFIED
  UNVERIFIED
  DUPLICATE
  FALSE_REPORT_SUSPECTED
}

enum IncidentStatus {
  SUBMITTED
  UNDER_REVIEW
  ACKNOWLEDGED
  ASSIGNED
  EN_ROUTE
  ON_SCENE
  RESOLVED
  CLOSED
  UNVERIFIED
  DUPLICATE
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  REASSIGNED
  COMPLETED
  CANCELLED
}

enum NotificationChannel {
  FCM
  SMS
  EMAIL
  IN_APP
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNKNOWN
}

model User {
  id            String        @id @default(uuid())
  fullName      String?       @map("full_name")
  email         String?       @unique
  phone         String?
  passwordHash  String?       @map("password_hash")
  role          UserRole      @default(REPORTER)
  accountStatus AccountStatus @default(ACTIVE) @map("account_status")
  agencyId      String?       @map("agency_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  lastLoginAt   DateTime?     @map("last_login_at")

  agency             Agency?                 @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  createdIncidents   Incident[]              @relation("UserCreatedIncidents")
  assignedIncidents  Assignment[]            @relation("UserAssignments")
  createdAssignments Assignment[]            @relation("UserCreatedAssignments")
  statusEvents       IncidentStatusEvent[]
  notifications      NotificationDelivery[]
  auditLogs          AuditLog[]
  media              IncidentMedia[]

  @@index([role, accountStatus])
  @@index([agencyId])
  @@map("users")
}

model Agency {
  id                   String     @id @default(uuid())
  name                 String
  agencyType           AgencyType @map("agency_type")
  contactConfiguration String?    @map("contact_configuration")
  serviceArea          String?    @map("service_area")
  isActive             Boolean    @default(true) @map("is_active")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  users       User[]
  assignments Assignment[]

  @@map("agencies")
}

model Incident {
  id                      String              @id @default(uuid())
  referenceCode           String              @unique @map("reference_code")
  createdByUserId         String?             @map("created_by_user_id")
  guestAccessTokenHash    String?             @map("guest_access_token_hash")
  idempotencyKey          String?             @unique @map("idempotency_key")
  category                IncidentCategory
  reporterSeverity        ReporterSeverity    @map("reporter_severity")
  operationalPriority     OperationalPriority? @map("operational_priority")
  description             String?
  vehicleCount            Int?                @map("vehicle_count")
  injuredPersonCount      Int?                @map("injured_person_count")
  fireSuspected           Boolean?            @map("fire_suspected")
  trappedPersonsSuspected Boolean?            @map("trapped_persons_suspected")
  roadBlockageSuspected   Boolean?            @map("road_blockage_suspected")
  occurredAtDevice        DateTime?           @map("occurred_at_device")
  receivedAt              DateTime            @default(now()) @map("received_at")
  latitude                Float
  longitude               Float
  locationAccuracyM       Float?              @map("location_accuracy_m")
  locationSource          LocationSource      @default(GPS) @map("location_source")
  landmarkOrAddress       String?             @map("landmark_or_address")
  status                  IncidentStatus      @default(SUBMITTED)
  verificationState       VerificationState   @default(PENDING) @map("verification_state")
  duplicateOfIncidentId   String?             @map("duplicate_of_incident_id")
  closedAt                DateTime?           @map("closed_at")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  createdByUser           User?                   @relation("UserCreatedIncidents", fields: [createdByUserId], references: [id], onDelete: SetNull)
  duplicateOf             Incident?               @relation("DuplicateIncidents", fields: [duplicateOfIncidentId], references: [id], onDelete: SetNull)
  duplicates              Incident[]              @relation("DuplicateIncidents")
  media                   IncidentMedia[]
  assignments             Assignment[]
  statusEvents            IncidentStatusEvent[]
  notificationDeliveries  NotificationDelivery[]

  @@index([status, receivedAt])
  @@index([verificationState])
  @@index([category])
  @@index([operationalPriority])
  @@map("incidents")
}

model IncidentMedia {
  id               String   @id @default(uuid())
  incidentId       String   @map("incident_id")
  storageKey       String   @map("storage_key")
  mimeType         String   @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  uploadedByUserId String?  @map("uploaded_by_user_id")
  reviewStatus     String   @default("PENDING") @map("review_status")
  createdAt        DateTime @default(now()) @map("created_at")

  incident         Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  uploadedByUser   User?    @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([incidentId])
  @@map("incident_media")
}

model Assignment {
  id                String           @id @default(uuid())
  incidentId        String           @map("incident_id")
  agencyId          String           @map("agency_id")
  assignedToUserId  String?          @map("assigned_to_user_id")
  assignedByUserId  String           @map("assigned_by_user_id")
  status            AssignmentStatus @default(ACTIVE)
  assignedAt        DateTime         @default(now()) @map("assigned_at")
  acceptedAt        DateTime?        @map("accepted_at")
  completedAt       DateTime?        @map("completed_at")
  notes             String?

  incident          Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  agency            Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignedToUser    User?            @relation("UserAssignments", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedByUser    User             @relation("UserCreatedAssignments", fields: [assignedByUserId], references: [id])

  @@index([incidentId])
  @@index([agencyId])
  @@index([assignedToUserId, status])
  @@map("assignments")
}

model IncidentStatusEvent {
  id           String          @id @default(uuid())
  incidentId   String          @map("incident_id")
  fromStatus   IncidentStatus? @map("from_status")
  toStatus     IncidentStatus  @map("to_status")
  actorUserId  String?         @map("actor_user_id")
  note         String?
  metadata     String?         // JSON string for SQLite/PG compatibility
  createdAt    DateTime        @default(now()) @map("created_at")

  incident     Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actorUser    User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("incident_status_events")
}

model NotificationDelivery {
  id                String              @id @default(uuid())
  incidentId        String?             @map("incident_id")
  recipientUserId   String?             @map("recipient_user_id")
  channel           NotificationChannel
  eventType         String              @map("event_type")
  providerMessageId String?             @map("provider_message_id")
  status            DeliveryStatus      @default(QUEUED)
  attemptCount      Int                 @default(0) @map("attempt_count")
  lastErrorCode     String?             @map("last_error_code")
  createdAt         DateTime            @default(now()) @map("created_at")
  nextAttemptAt     DateTime?           @map("next_attempt_at")
  sentAt            DateTime?           @map("sent_at")
  deliveredAt       DateTime?           @map("delivered_at")

  incident          Incident?           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  recipientUser     User?               @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([incidentId])
  @@map("notification_deliveries")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  ipAddress   String?  @map("ip_address")
  metadata    String?  // JSON string
  createdAt   DateTime @default(now()) @map("created_at")

  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
