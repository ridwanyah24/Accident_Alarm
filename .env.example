# System Environment Configuration Template
# NOTE: Replace all placeholder values for local development and production.
# Never commit active credentials or API keys.

# Node Environment & Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
WEB_APP_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
# For Render + Supabase, use the Supavisor Session pooler URL (port 5432),
# not a direct endpoint that may be IPv6-only. Keep real credentials out of Git.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accident_alarm?schema=public

# Redis (Job Queue - BullMQ/Worker)
REDIS_URL=redis://localhost:6379

# Authentication & Security
# Generate secure random secret using: openssl rand -base64 32
AUTH_SECRET=development_super_secret_auth_token_key_min_32_chars_long
JWT_EXPIRES_IN=24h
GUEST_TOKEN_SECRET=development_guest_access_token_secret_key_32_chars

# Verified Public Emergency Contact Configuration (Safe defaults)
# Only verified national or local emergency helpline numbers should be shown to the public.
EMERGENCY_HELPLINE_PRIMARY=112
EMERGENCY_HELPLINE_POLICE=199
EMERGENCY_HELPLINE_AMBULANCE=112
EMERGENCY_HELPLINE_FIRE=112
EMERGENCY_COUNTRY_CODE=NG
EMERGENCY_SERVICE_DISCLAIMER="This application is an incident reporting aid and does NOT guarantee immediate dispatch. For life-threatening emergencies, dial the official emergency numbers immediately."

# Object Storage for Evidence Photos (S3-compatible / Local Mock)
OBJECT_STORAGE_PROVIDER=local_mock
OBJECT_STORAGE_ENDPOINT=http://localhost:4000/api/v1/uploads/files
OBJECT_STORAGE_BUCKET=incident-evidence
OBJECT_STORAGE_ACCESS_KEY=mock_access_key
OBJECT_STORAGE_SECRET_KEY=mock_secret_key
OBJECT_STORAGE_LOCAL_DIR=./uploads

# Notification Providers (Simulated / Local development by default)
NOTIFICATION_PROVIDER=simulated
FCM_ENABLED=false
FCM_PROJECT_ID=mock-accident-alarm-project
FCM_CLIENT_EMAIL=mock-fcm@accident-alarm.iam.gserviceaccount.com
FCM_PRIVATE_KEY=""
SMS_ENABLED=false
SMS_PROVIDER=mock
EMAIL_ENABLED=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
INCIDENT_RATE_LIMIT_MAX=10

# Map SDK (Optional for manual pin selector)
MAPS_PROVIDER=osm
MAPS_API_KEY=
