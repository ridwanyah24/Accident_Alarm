{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web-dashboard": {
      "root": "apps/web-dashboard",
      "framework": "vite",
      "installCommand": "cd ../.. && npm ci --include=dev",
      "buildCommand": "cd ../.. && npm run build --workspace=packages/api-contracts && npm run build --workspace=apps/web-dashboard",
      "outputDirectory": "dist"
    },
    "api": {
      "root": "services/api",
      "framework": "express",
      "entrypoint": "src/vercel.ts",
      "installCommand": "cd ../.. && npm ci --include=dev",
      "buildCommand": "cd ../.. && npm run build --workspace=packages/api-contracts && npm run build --workspace=services/api"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/health/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web-dashboard" }
    }
  ]
}